{
  "name": "cavalry-mcp",
  "version": "2.1.0",
  "description": "MCP server for Cavalry animation software — batch scene building, keyframe animations with presets, filmstrip previews, video render via render queue, and real data readback. Works with ZCode and any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cavalry-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cavalry",
    "animation",
    "motion-design",
    "video",
    "stallion",
    "zcode",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}

{
  "name": "cavalry-mcp",
  "version": "2.0.0",
  "description": "MCP server for Cavalry animation software — create layers, set attributes, keyframe animations, render frames, and save scenes, with real data readback. Works with ZCode and any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cavalry-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cavalry",
    "animation",
    "motion-design",
    "stallion",
    "zcode",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "cavalry-mcp",
  "version": "3.0.0",
  "description": "Low-token Cavalry MCP and Stallion CLI with batched motion helpers, procedural presets, and atomic Undo.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cavalry-mcp": "dist/index.js",
    "stallion": "bin/stallion-cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node --import tsx --test",
    "test:watch": "node --import tsx --test --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cavalry",
    "animation",
    "motion-design",
    "video",
    "stallion",
    "zcode",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}

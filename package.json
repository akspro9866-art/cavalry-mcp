{
  "name": "cavalry-mcp",
  "version": "3.4.0",
  "description": "Low-token Cavalry MCP and Stallion CLI with batched motion helpers, procedural presets, and atomic Undo.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cavalry-mcp": "dist/index.js",
    "stallion": "bin/stallion-cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && node scripts/build-preset-manifest.mjs",
    "build:manifest": "node scripts/build-preset-manifest.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node test/run-tests.mjs",
    "test:ci": "npm run lint && npm test",
    "lint": "eslint .",
    "test:live": "npm run build && node test/run-tests.mjs --live",
    "test:watch": "node test/run-tests.mjs --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cavalry",
    "animation",
    "motion-design",
    "video",
    "stallion",
    "zcode",
    "ai-tools"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "author": "cavalry-mcp contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akspro9866-art/cavalry-mcp.git"
  },
  "homepage": "https://github.com/akspro9866-art/cavalry-mcp#readme",
  "bugs": {
    "url": "https://github.com/akspro9866-art/cavalry-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib/index.js",
    "./core": {
      "types": "./dist/core-exports.d.ts",
      "import": "./dist/core-exports.js",
      "default": "./dist/core-exports.js"
    },
    "./package.json": "./package.json"
  }
}
